# Site
NEXT_PUBLIC_SITE_URL=https://lp.firmadlakazdego.pl

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (optional - email notifications + autoresponder)
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=kontakt@firmadlakazdego.pl

# GTM (recommended - single container for GA4 + Google Ads)
NEXT_PUBLIC_GTM_ID=

# Cookiebot (optional - replaces built-in cookie banner)
NEXT_PUBLIC_COOKIEBOT_ID=

# Meta Pixel (client-side)
NEXT_PUBLIC_META_PIXEL_ID=

# Meta Conversions API (server-side)
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_CAPI_TEST_EVENT_CODE=

# Google Analytics / Ads (fallback when no GTM)
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=

# TikTok Pixel (client-side)
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# TikTok Events API (server-side)
TIKTOK_PIXEL_ID=
TIKTOK_ACCESS_TOKEN=

# Qualified lead webhook
QUALIFIED_WEBHOOK_SECRET=

# Google Sheets (zbieranie leadów)
# Service account z Google Cloud Console z włączonym Sheets API
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
# ID arkusza (fragment URL między /d/ a /edit)
SHEET_ID=
# Nazwa zakładki zbiorczej (domyślnie "Wszystkie")
SHEET_TAB_ALL=Wszystkie
